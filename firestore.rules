rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ---- Private cloud save: one document per authenticated player ----
    match /users/{userId}/saves/{saveId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && saveId == 'main'
        && request.resource.data.keys().hasOnly(['schema', 'ownerUid', 'bundle', 'updatedAt'])
        && request.resource.data.schema == 1
        && request.resource.data.ownerUid == userId
        && request.resource.data.updatedAt == request.time
        && request.resource.data.bundle.v == 1
        && request.resource.data.bundle.name is string
        && request.resource.data.bundle.name.size() <= 16
        && request.resource.data.bundle.scores is list
        && request.resource.data.bundle.scores.size() <= 30;

      allow delete: if request.auth != null
        && request.auth.uid == userId
        && saveId == 'main';
    }

    // ---- Public global leaderboard: one doc per (lane, player) ----
    // A leaderboard is by definition public to read. Writes are constrained:
    // owner-only, sane payload, and monotone personal-best growth. The
    // monotone rule makes it impossible to forge a higher historical score
    // for another account or to shrink a rival's entry.
    match /leaderboards/{mode}/entries/{uid} {
      function sane() {
        return request.resource.data.keys().hasOnly(['uid', 'name', 'score', 'level', 'date'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 16
          && request.resource.data.score is number
          && request.resource.data.score >= 0
          && request.resource.data.score <= 100000000
          && request.resource.data.level is number
          && request.resource.data.level >= 1
          && request.resource.data.level <= 99
          && request.resource.data.date is number;
      }

      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && sane();

      allow update: if request.auth != null
        && request.auth.uid == uid
        && sane()
        && request.resource.data.score >= resource.data.score
        && request.resource.data.level >= resource.data.level;

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
